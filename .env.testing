APP_NAME=Passa
APP_ENV=testing
APP_KEY=base64:Ay6TXQXIwd4nkxsFSqqo2uLF+nY1CAep83Mq4ovv6tk=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Mesmo Postgres do compose.yaml, banco separado (criado pelo docker/postgres/init.sql).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=passa_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=array

NETWORK_SECRET=passa-network-test-secret
